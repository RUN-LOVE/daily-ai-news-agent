# ===== Application =====
SERVER_PORT=8080
APP_DB_PATH=data/news-agent.db
APP_WORKSPACE=workspace
APP_SCHEDULER_ENABLED=true

# ===== LLM (OpenAI-compatible endpoint) =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
LLM_MAX_STEPS=12

# ===== News search (enabled from Day 3) =====
SEARCH_PROVIDER=bing

# ===== Email push (optional, enabled from Day 5) =====
PUSH_EMAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
